# Local SQLite database; resolved relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Safe local default. Set to false to call OpenAI.
MOCK_LLM="true"

# Required only when MOCK_LLM=false or running real-model evals.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Opt-in manual/real-model eval gates.
RUN_REAL_CLAIM_VERIFIER="false"
RUN_REAL_V3_VERIFIER_EVAL="false"