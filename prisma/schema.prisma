// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../lib/prisma-generated"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Note {
  id        String   @id @default(cuid())
  content   String // 我们输入的内容
  createdAt DateTime @default(now()) // 创建时间
}

// Reflection 会先独立保存，因此即使 LLM 调用失败，用户写的内容也不会丢失。
model Reflection {
  id        String      @id @default(cuid())
  content   String
  createdAt DateTime    @default(now())
  analysis  AIAnalysis?
}

// reflectionId 表示一条 Reflection 当前对应一份分析。
// model 记录使用了哪个 LLM，方便以后切换模型或重新分析
// onDelete: Cascade 表示删除 Reflection 时，一并删除对应分析。
// reflection 字段保持在同一行 
model AIAnalysis {
  id           String   @id @default(cuid())
  reflectionId String   @unique
  result       String
  model        String?
  createdAt    DateTime @default(now())

  reflection Reflection @relation(fields: [reflectionId], references: [id], onDelete: Cascade)
}

model RecentPatternAnalysis {
  id              String   @id @default(cuid())
  reflectionIds   String
  reflectionCount Int
  result          String
  model           String?
  createdAt       DateTime @default(now())
}

// practiceId：V1 固定练习标识；旧 Session 使用它回到静态 catalog
// practiceSnapshot：V2 自定义 source + exercise 的不可变 JSON 快照
// answer：用户的英文总结
// analysis：AI 返回的结构化反馈，以 JSON 字符串保存

model ListeningSession {
  id               String   @id @default(cuid())
  practiceId       String
  answer           String
  analysis         String?
  model            String?
  practiceSnapshot String?
  learningUnitId   String?
  createdAt        DateTime @default(now())

  learningUnit LearningUnit? @relation(fields: [learningUnitId], references: [id], onDelete: SetNull)

  @@index([learningUnitId])
}

// Material owns reusable source-level metadata. String fields are validated at
// the API boundary so SQLite stays easy to migrate and future values can evolve.
model Material {
  id         String   @id @default(cuid())
  type       String
  title      String
  sourceUrl  String?
  difficulty String?
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  units LearningUnit[]
}

// LearningUnit is the durable progress boundary shared by audio and text.
// Session snapshots still preserve exactly what was practiced at that moment.
model LearningUnit {
  id         String   @id @default(cuid())
  materialId String
  order      Int
  type       String
  start      Float?
  end        Float?
  content    String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  material Material           @relation(fields: [materialId], references: [id], onDelete: Cascade)
  sessions ListeningSession[]

  @@unique([materialId, order])
  @@index([materialId, status])
}
